[Unit]
Description=RealGuard DINOv3 ViT-7B candidate detector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ymk
Group=ymk
WorkingDirectory=/home/ymk/services/dinov3-onnx-service
Environment=DINOV3_PACKAGE_DIR=/home/ymk/model_registry/dinov3_vit7b16_linear_onnx_fp16
Environment=DINOV3_PROVIDER=cpu
Environment=DINOV3_INTRA_OP_THREADS=16
Environment=DINOV3_EAGER_LOAD=1
Environment=DINOV3_QUEUE_WAIT_SECONDS=20
Environment=CUDA_VISIBLE_DEVICES=
ExecStart=/home/ymk/miniconda3/envs/realguard/bin/gunicorn --workers 1 --threads 2 --worker-class gthread --bind 127.0.0.1:5071 --timeout 600 --graceful-timeout 30 --keep-alive 5 --access-logfile - --error-logfile - service:app
Restart=always
RestartSec=8
TimeoutStopSec=45
KillSignal=SIGTERM
Nice=5
CPUWeight=50
MemoryHigh=64G
MemoryMax=80G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
LimitNOFILE=65536
UMask=0077

[Install]
WantedBy=multi-user.target
