[Unit]
Description=RealGuard DINOv3 tunnel to the public application server
After=network-online.target realguard-dinov3.service
Wants=network-online.target

[Service]
Type=simple
User=ymk
ExecStart=/usr/bin/ssh -N -T -o ExitOnForwardFailure=yes -o ConnectTimeout=10 -o ConnectionAttempts=1 -o ServerAliveInterval=10 -o ServerAliveCountMax=2 -o TCPKeepAlive=yes -o StrictHostKeyChecking=accept-new -i /home/ymk/.ssh/realguard_web_tunnel_ed25519 -R 127.0.0.1:15002:127.0.0.1:5071 ubuntu@124.221.92.85
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
