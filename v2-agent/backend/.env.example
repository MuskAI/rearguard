DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3-vl-flash
# Text model used to explain an existing report. Defaults to VLM_MODEL.
JIANZHEN_REPORT_QA_MODEL=qwen3-vl-flash
JIANZHEN_REPORT_QA_MAX_CONCURRENCY=4
JIANZHEN_REPORT_QA_QUEUE_TIMEOUT_SECONDS=8
JIANZHEN_REPORT_QA_RATE_LIMIT=20
JIANZHEN_REPORT_QA_RATE_WINDOW_SECONDS=60
JIANZHEN_REPORT_QA_WEB_SEARCH_ENABLED=1
JIANZHEN_REPORT_QA_SEARCH_MODEL=qwen-plus
JIANZHEN_REPORT_QA_CLAIM_MODEL=qwen3-vl-flash
JIANZHEN_REPORT_QA_SEARCH_STRATEGY=agent
JIANZHEN_REPORT_QA_SEARCH_FALLBACK_STRATEGY=max
JIANZHEN_REPORT_QA_SEARCH_TIMEOUT_SECONDS=42
JIANZHEN_REPORT_QA_SEARCH_MAX_SOURCES=10
JIANZHEN_REPORT_QA_SEARCH_CACHE_SECONDS=900
JIANZHEN_REPORT_QA_SEARCH_MAX_PREVIEW_BYTES=900000
# A second, forced-search recall lane using DashScope Responses. It runs in parallel
# with the native Qwen search lane; its summaries are never treated as evidence.
JIANZHEN_REPORT_QA_RESPONSES_RECALL_ENABLED=1
JIANZHEN_REPORT_QA_RESPONSES_RECALL_MODEL=qwen3.8-max
JIANZHEN_REPORT_QA_RESPONSES_RECALL_TIMEOUT_SECONDS=38
# Optional independent recall providers. Results still require page/record verification.
GOOGLE_FACTCHECK_API_KEY=
BRAVE_SEARCH_API_KEY=
JIANZHEN_REPORT_QA_OPTIONAL_SEARCH_TIMEOUT_SECONDS=12
JIANZHEN_REPORT_QA_WEB_EXTRACT_ENABLED=1
JIANZHEN_REPORT_QA_WEB_EXTRACT_MODEL=qwen3.8-max
JIANZHEN_REPORT_QA_WEB_CLASSIFIER_MODEL=qwen-flash
JIANZHEN_REPORT_QA_WEB_EXTRACT_TIMEOUT_SECONDS=35
JIANZHEN_REPORT_QA_WEB_EXTRACT_MAX_URLS=5
# Optional. By default this is derived from DASHSCOPE_BASE_URL by replacing
# /compatible-mode/v1 with /api/v1 so native search sources can be returned.
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# Public cooperation form: per-source abuse protection and default retention.
JIANZHEN_COLLABORATION_RATE_LIMIT=5
JIANZHEN_COLLABORATION_RATE_WINDOW_SECONDS=3600
JIANZHEN_COLLABORATION_INQUIRY_RETENTION_DAYS=365
JIANZHEN_ACCESS_TOKEN=
# Separate break-glass token for health, metrics, and cross-tenant admin APIs.
# Never reuse JIANZHEN_ACCESS_TOKEN here.
JIANZHEN_ADMIN_ACCESS_TOKEN=
# Production defaults to authenticated detection. Set this only for isolated
# local demos; public hosts must keep it false.
JIANZHEN_ALLOW_ANONYMOUS_DETECT=false
JIANZHEN_ENV=production
JIANZHEN_REQUIRE_SESSION_CSRF=1
JIANZHEN_ALLOW_DIRECT_DEVELOPER_KEYS=false
JIANZHEN_ALLOW_LEGACY_REPORT_SHARES=false
JIANZHEN_DEVELOPER_AUTH_URL=http://127.0.0.1:5000/api/developer/keys/verify
REALGUARD_DEVELOPER_AUTH_SECRET=change-this-shared-internal-secret
# Independent signing key for expiring public report links. Do not reuse any
# access, admin, session, or developer authentication secret.
JIANZHEN_REPORT_SHARE_SECRET=replace-with-a-random-independent-secret-at-least-32-bytes
JIANZHEN_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
JIANZHEN_PUBLIC_BASE_URL=https://www.rrreal.cn
JIANZHEN_REPORT_SHARE_DEFAULT_SECONDS=604800
JIANZHEN_REPORT_SHARE_MAX_SECONDS=2592000

# Immutable V2 evidence reports. Configure exactly one private-key source.
# Inline keys must be a 32-byte Ed25519 seed encoded as base64:<value>.
# Key files may contain unencrypted PKCS8 PEM or base64:<value>, must be an
# absolute non-symlink path, and must have no group/world permissions.
JIANZHEN_EVIDENCE_SIGNING_KEY_ID=huijian-evidence-2026-01
JIANZHEN_EVIDENCE_SIGNING_PRIVATE_KEY=
# JIANZHEN_EVIDENCE_SIGNING_PRIVATE_KEY_FILE=/etc/realguard/evidence-signing-ed25519.pem
# Optional key-rotation trust registry: {"keyId":"base64-public-key"}
JIANZHEN_EVIDENCE_VERIFY_PUBLIC_KEYS={}

# SQLite persistence for history, analysis cache, and lightweight metrics.
JIANZHEN_DATA_DIR=/opt/jianzhen-v2/data
REALGUARD_PRIVACY_ERASURE_LEDGER_PATH=/opt/realguard-data/privacy-erasure/privacy-erasure-tombstones.sqlite3
JIANZHEN_IMAGE_SUSPECT_THRESHOLD=0.62
JIANZHEN_IMAGE_HIGH_THRESHOLD=0.82
JIANZHEN_IMAGE_REGION_THRESHOLD=0.72
JIANZHEN_IMAGE_AUXILIARY_WEIGHT=0.20
JIANZHEN_IMAGE_AUXILIARY_DISPLAY_CAP=0.35
JIANZHEN_ANALYSIS_CACHE_VERSION=v8-provenance-first
JIANZHEN_REQUEST_EVENT_RETENTION_DAYS=90
JIANZHEN_TOKEN_USAGE_RETENTION_DAYS=730
JIANZHEN_REPORT_SHARE_ACCESS_RETENTION_DAYS=90
JIANZHEN_REPORT_SHARE_RETENTION_DAYS=730
JIANZHEN_DETECTION_MAX_CONCURRENCY=4
JIANZHEN_DETECTION_QUEUE_TIMEOUT_SECONDS=15
JIANZHEN_FORENSICS_MAX_CONCURRENCY=2

# Provenance-first detector on the 66 server. It is reached through a
# loopback-only reverse SSH tunnel on the public host.
JIANZHEN_PROVENANCE_PRECHECK_URL=http://127.0.0.1:15066
JIANZHEN_PROVENANCE_PRECHECK_TOKEN=replace-with-the-shared-precheck-token
JIANZHEN_PROVENANCE_PRECHECK_TIMEOUT=8
JIANZHEN_PROVENANCE_PRECHECK_ORIGINAL_TIMEOUT=20
JIANZHEN_PROVENANCE_PRECHECK_DIRECT_UPLOAD_MAX_BYTES=1572864
JIANZHEN_PROVENANCE_PRECHECK_SCAN_MAX_SIDE=1536
JIANZHEN_PROVENANCE_PRECHECK_SCAN_QUALITY=94

# Optional: Google Gemini SynthID watermark evidence.
# Only the detection path is used; watermark removal/bypass code is not called.
SYNTHID_ENABLED=false
SYNTHID_REPO_PATH=/opt/reverse-SynthID
SYNTHID_CODEBOOK_PATH=/opt/reverse-SynthID/artifacts/spectral_codebook_v4.npz
SYNTHID_MODEL_PROFILES=auto
SYNTHID_POSSIBLE_THRESHOLD=0.53
SYNTHID_DETECTION_THRESHOLD=0.75
SYNTHID_ATTRIBUTION_MARGIN=0.08
SYNTHID_PROFILE_CACHE_SIZE=2

# Optional: visible AI watermark detection-only module.
# Uses template/NCC localization for Gemini-family visible sparkle and a generic corner-overlay heuristic.
VISIBLE_WATERMARK_ENABLED=true
VISIBLE_WATERMARK_GEMINI_CONFIDENCE_THRESHOLD=0.72
VISIBLE_WATERMARK_GEMINI_SPATIAL_THRESHOLD=0.62
VISIBLE_WATERMARK_GEMINI_GRADIENT_THRESHOLD=0.35
VISIBLE_WATERMARK_GENERIC_CORNER_THRESHOLD=0.84
VISIBLE_WATERMARK_GENERIC_IMAGE_ENABLED=false
